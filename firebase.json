{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/nights/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico|mp3|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/ads.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml"
          }
        ]
      }
    ],
    "redirects": [],
    "rewrites": [
      {
        "source": "/u/**",
        "function": "profilePage"
      },
      {
        "source": "/live",
        "function": "roomOG"
      },
      {
        "source": "/join",
        "function": "joinOG"
      },
      {
        "source": "/admin-api/adminGiveCoins",
        "function": "adminGiveCoins"
      },
      {
        "source": "/admin-api/adminSetBanStatus",
        "function": "adminSetBanStatus"
      },
      {
        "source": "/admin-api/adminMarkPayout",
        "function": "adminMarkPayout"
      },
      {
        "source": "/admin-api/adminSendPushNotification",
        "function": "adminSendPushNotification"
      },
      {
        "source": "/admin-api/deleteAccount",
        "function": "deleteAccount"
      },
      {
        "source": "/admin-api/runAnonymousCleanupNow",
        "function": "runAnonymousCleanupNow"
      },
      {
        "source": "/nights",
        "destination": "/nights/index.html"
      },
      {
        "source": "/nights/venue",
        "destination": "/nights/venue.html"
      },
      {
        "source": "/nights/admin",
        "destination": "/nights/admin.html"
      },
      {
        "source": "/d/**",
        "function": "dateOG"
      },
      {
        "source": "/m/**",
        "function": "meetupOG"
      },
      {
        "source": "/s/**",
        "function": "shareImage"
      },
      {
        "source": "/api/declineCall",
        "function": "declineCall"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs22",
      "runWith": {
        "secrets": [
          "AGORA_APP_ID",
          "AGORA_APP_CERTIFICATE",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET"
        ]
      }
    },
    {
      "source": "functions-nights",
      "codebase": "nights",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}