{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/ads.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain" },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [ { "key": "Content-Type", "value": "text/plain" } ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [ { "key": "Content-Type", "value": "application/xml" } ]
      }
    ],
    "redirects": [],
    "rewrites": [
      { "source": "/u/**", "function": "profileOG" },
      { "source": "/live", "function": "roomOG" },
      { "source": "/join", "function": "joinOG" },
      { "source": "/spirits", "destination": "/spirits.html" },
      { "source": "/spirits-admin", "destination": "/spirits-admin.html" },
      { "source": "/briefing", "destination": "/briefing.html" },
      { "source": "/admin-api/adminGiveCoins", "function": "adminGiveCoins" },
      { "source": "/admin-api/adminSetBanStatus", "function": "adminSetBanStatus" },
      { "source": "/admin-api/adminMarkPayout", "function": "adminMarkPayout" },
      { "source": "/admin-api/adminSendPushNotification", "function": "adminSendPushNotification" },
      { "source": "/admin-api/deleteAccount", "function": "deleteAccount" },
      { "source": "/admin-api/runAnonymousCleanupNow", "function": "runAnonymousCleanupNow" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "database": { "rules": "database.rules.json" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [ "node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local" ],
      "runtime": "nodejs22",
      "runWith": {
        "secrets": [ "AGORA_APP_ID", "AGORA_APP_CERTIFICATE", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET" ]
      }
    }
  ],
  "storage": { "rules": "storage.rules" }
}
