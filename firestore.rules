rules_version = '2';

// Whisper+me Dates — Firestore security rules.
// (Whisper+me itself uses the Realtime Database; Firestore is only used by Dates.)
// Money, deposits, strikes and dates are written ONLY by Cloud Functions (which bypass these rules).
// Clients can write: venue applications, a venue's own tickets, their own "ID uploaded" flag, and reports.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function me() { return request.auth.uid; }
    // Same admin account as Whisper+me (see database.rules.json).
    function isAdmin() { return request.auth != null && (request.auth.token.admin == true || request.auth.uid in ['v6aIXY12MDY9ci1wWJmCiLOAKoG2']); }
    function venueData(vid) { return get(/databases/$(db)/documents/venues/$(vid)).data; }
    function ownsVenue(vid) { return signedIn() && venueData(vid).ownerUid == me(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /settings/{id} {
      allow read: if true;
      allow write: if false; // admin changes go through nightsAdminAction (logged)
    }

    // Dates profile: deposit, strikes, break, verification. Members can only flag that they uploaded an ID.
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow update: if signedIn() && me() == uid && changed().hasOnly(['idUploaded']) && request.resource.data.idUploaded == true;
      allow create, delete: if false;
    }

    match /venues/{vid} {
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (signedIn() && resource.data.ownerUid == me());
      allow create: if signedIn()
        && request.resource.data.ownerUid == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.sales == 0
        && !('stripeAccountId' in request.resource.data)
        && !('payoutsEnabled' in request.resource.data);
      allow update: if signedIn() && resource.data.ownerUid == me()
        && !changed().hasAny(['status','ownerUid','stripeAccountId','payoutsEnabled','sales','pausedReason']);
      allow delete: if false;
    }

    // Tickets: anyone can browse live ones (even before signing up).
    match /tickets/{tid} {
      allow read: if (resource.data.status == 'live' && resource.data.adminHidden == false)
        || isAdmin() || ownsVenue(resource.data.venueId);
      allow create: if ownsVenue(request.resource.data.venueId)
        && venueData(request.resource.data.venueId).status == 'approved'
        && request.resource.data.status == 'live'
        && request.resource.data.adminHidden == false
        && request.resource.data.sold == 0
        && request.resource.data.held == 0
        && request.resource.data.size in [2, 4]
        && request.resource.data.category in ['Dinner', 'Activities', 'Concerts', 'Movies', 'Other']
        && request.resource.data.price is int && request.resource.data.price >= 500
        && request.resource.data.quantity is int && request.resource.data.quantity > 0
        && request.resource.data.items is list && request.resource.data.items.size() > 0;
      allow update: if ownsVenue(resource.data.venueId)
        && !changed().hasAny(['sold','held','venueId','adminHidden','hiddenReason','price','size'])
        && request.resource.data.status in ['live','paused','ended']
        && request.resource.data.quantity >= resource.data.sold + resource.data.held;
      allow delete: if false;
    }

    // Dates (bookings): people on it or who asked to join, the venue, the admin,
    // and anyone signed in for dates that are open to requests.
    match /dates/{id} {
      allow read: if isAdmin()
        || (signedIn() && me() in resource.data.involvedUids)
        || (signedIn() && resource.data.open == true && resource.data.live == true)
        || ownsVenue(resource.data.venueId);
      allow write: if false;
    }

    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.by == me()
        && request.resource.data.status == 'open'
        && request.resource.data.aboutType in ['user','venue']
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 80
        && request.resource.data.detail.size() <= 1000;
      allow read: if isAdmin() || (signedIn() && resource.data.by == me());
      allow update, delete: if false;
    }

    match /payouts/{id} {
      allow read: if isAdmin() || ownsVenue(resource.data.venueId);
      allow write: if false;
    }
    match /ledger/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /stats/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /adminLog/{id} { allow read: if isAdmin(); allow write: if false; }
  }
}
