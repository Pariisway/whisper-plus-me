{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "online",
        "lastSeen",
        "earnings"
      ],
      "$uid": {
        "name": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "bio": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "instagram": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "twitter": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "website": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "photo": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "email": {
          ".write": "auth != null && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || (auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'))",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "price": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
        },
        "lat": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "lng": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "online": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isBoolean()"
        },
        "lastSeen": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isNumber()"
        },
        "callsEnabled": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "chat": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
        ".indexOn": [
          "ts"
        ],
        "$msgId": {
          ".write": "auth != null && !root.child('roomBlocks/'+$room+'/'+auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('roomModerators/'+$room+'/'+auth.uid).val() === true)))",
          ".validate": "newData.hasChildren(['uid','ts','type']) && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 600000 && (!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 1000)) && (!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 60))"
        }
      }
    },
    "liveMics": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2')"
        }
      }
    },
    "memberRooms": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt",
        "ownerId"
      ],
      "$roomId": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || (!data.exists() && newData.child('ownerId').val() === auth.uid) || (data.exists() && data.child('ownerId').val() === auth.uid && (!newData.exists() || newData.child('ownerId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['name','cost','ownerId','ownerName','createdAt']) && $roomId.length <= 80 && $roomId.matches(/^mr_[A-Za-z0-9]+_[0-9]+$/) && newData.child('name').isString() && newData.child('name').val().length <= 80",
        "occupants": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
        },
        "cost": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        }
      }
    },
    "memberRoomSessions": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || root.child('memberRooms/'+$roomId+'/ownerId').val() === auth.uid) && !newData.exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      }
    },
    "memberRoomCooldown": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "memberRoomLedger": {
      ".read": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": false
    },
    "siteRevenue": {
      ".read": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": false
    },
    "stripeGrossRevenue": {
      ".read": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": false
    },
    "calls": {
      ".read": "auth != null && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || ((query.orderByChild === 'from' || query.orderByChild === 'to') && query.equalTo === auth.uid))",
      ".indexOn": [
        "from",
        "to"
      ],
      "$callId": {
        ".write": "auth != null && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || (auth.token.firebase.sign_in_provider !== 'anonymous' && (newData.child('from').val() === auth.uid || newData.child('to').val() === auth.uid || data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)))",
        ".read": "auth != null && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)"
      }
    },
    "callLedger": {
      ".read": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": false
    },
    "coinPurchases": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "liveMicLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "siteNotifications": {
      ".read": "auth != null",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
      }
    },
    "roomMemberOnly": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
        ".validate": "newData.isBoolean()"
      }
    },
    "memberRoomEarnings": {
      ".read": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": false
    },
    "presetRooms": {
      ".read": "auth != null",
      ".write": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "hiddenPresetRooms": {
      ".read": "auth != null",
      ".write": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "roomModerators": {
      ".read": "auth != null",
      ".write": "auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "roomBlocks": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || root.child('roomModerators/'+$roomId+'/'+auth.uid).val() === true)"
        }
      }
    },
    "stripeConnectAccounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "spirits": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritPending": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['room','isAnonymous','ts'])"
      }
    },
    "orgCodes": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritFeed": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "config": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritCallHistory": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritWorkers": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "organizations": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritCalls": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritAdminResources": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "spiritSurveys": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "orgUsers": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "landing": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "adminActivity": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".write": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      ".indexOn": [
        "ts"
      ]
    },
    "userPrivate": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2')",
        ".write": "auth != null && (auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2' || (auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'))",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$other": {
          ".validate": "false"
        }
      },
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'"
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "$other": {
          ".validate": "newData.isBoolean() || !newData.exists()"
        }
      }
    },
    "userReports": {
      ".read": "auth != null && auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2'",
      "$rid": {
        ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid && auth.token.firebase.sign_in_provider !== 'anonymous') || auth.uid === 'v6aIXY12MDY9ci1wWJmCiLOAKoG2')",
        ".validate": "newData.hasChildren(['by','about','reason','ts']) || !newData.exists()"
      }
    }
  }
}